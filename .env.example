# Research RAG — environment configuration
# Copy to .env and adjust. Every variable is optional; the defaults run a
# fully functional offline system (PyMuPDF parsing, section-aware chunking,
# hashing-embedder fallback, BM25, RRF, extractive answering).
#
# All variables are prefixed RESEARCHRAG_ and read by researchrag/config.py.

# ---------------------------------------------------------------------------
# Paths (default: <repo>/data/...)
# ---------------------------------------------------------------------------
# RESEARCHRAG_DATA_DIR=./data
# RESEARCHRAG_DATABASE_PATH=./data/researchrag.db
# RESEARCHRAG_QDRANT_PATH=./data/qdrant
# RESEARCHRAG_ARTIFACTS_DIR=./data/artifacts
# RESEARCHRAG_EVALS_DIR=./evals

# ---------------------------------------------------------------------------
# Parsing
# ---------------------------------------------------------------------------
# 'pymupdf' (default, lightweight, no torch) or 'docling' (pip install "researchrag[docling]")
RESEARCHRAG_PARSER_BACKEND=pymupdf
# RESEARCHRAG_ENABLE_OCR=false
# RESEARCHRAG_OCR_LANGUAGE=eng

# ---------------------------------------------------------------------------
# Chunking (hierarchical: child retrieval units + parent section context)
# ---------------------------------------------------------------------------
# 'section_aware' (default) or 'fixed_size'
RESEARCHRAG_CHUNK_STRATEGY=section_aware
RESEARCHRAG_CHUNK_MAX_TOKENS=400
RESEARCHRAG_CHUNK_PARENT_MAX_TOKENS=3000
# RESEARCHRAG_FIXED_CHUNK_TOKENS=500
# RESEARCHRAG_FIXED_CHUNK_OVERLAP_TOKENS=80

# ---------------------------------------------------------------------------
# Dense embeddings (fastembed / ONNX — no PyTorch)
# ---------------------------------------------------------------------------
# Weights download from Hugging Face on first use. If the download is
# impossible, the offline hashing embedder (768-d) is used and the API
# reports which embedder is active.
RESEARCHRAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# RESEARCHRAG_EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Retrieval (dense + sparse BM25 -> RRF -> rerank)
# ---------------------------------------------------------------------------
RESEARCHRAG_DENSE_TOP_N=50
RESEARCHRAG_SPARSE_TOP_N=50
# RRF constant (60 = published default, Cormack et al. 2009)
RESEARCHRAG_RRF_K=60
RESEARCHRAG_RRF_DENSE_WEIGHT=1.0
RESEARCHRAG_RRF_SPARSE_WEIGHT=1.0
# Candidates sent to the reranker, and final evidence chunks returned
RESEARCHRAG_RERANKER_TOP_M=30
RESEARCHRAG_FINAL_TOP_K=8
# Global token budget for the assembled evidence package
RESEARCHRAG_EVIDENCE_MAX_TOKENS=4000
RESEARCHRAG_USE_PARENT_CONTEXT=true

# ---------------------------------------------------------------------------
# Reranking
# ---------------------------------------------------------------------------
# 'local' (ONNX cross-encoder via fastembed; weights download on first use),
# 'cohere', 'jina' (hosted), or 'none'
RESEARCHRAG_RERANKER=local
RESEARCHRAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RESEARCHRAG_COHERE_API_KEY=
# RESEARCHRAG_JINA_API_KEY=

# ---------------------------------------------------------------------------
# LLM (grounded generation; optional — offline mode answers extractively)
# ---------------------------------------------------------------------------
# 'openai_compatible' (OpenAI / Ollama / vLLM / LM Studio), 'anthropic', or 'offline'
RESEARCHRAG_LLM_PROVIDER=offline
RESEARCHRAG_LLM_MODEL=gpt-4o-mini
# Point at a local server for offline generative answering, e.g.:
#   RESEARCHRAG_LLM_BASE_URL=http://localhost:11434/v1   (Ollama)
#   RESEARCHRAG_LLM_BASE_URL=http://localhost:11435/v1   (scripts/mock_llm_server.py)
# RESEARCHRAG_LLM_BASE_URL=
# RESEARCHRAG_LLM_API_KEY=
# RESEARCHRAG_LLM_TEMPERATURE=0.2
# RESEARCHRAG_LLM_MAX_TOKENS=4096
# RESEARCHRAG_LLM_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# Sandbox for generated-code execution (time + memory limits, scrubbed env)
# ---------------------------------------------------------------------------
RESEARCHRAG_EXECUTION_TIMEOUT_S=120
RESEARCHRAG_EXECUTION_MEMORY_MB=1024
RESEARCHRAG_EXECUTION_ALLOW_NETWORK=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# RESEARCHRAG_LOG_LEVEL=INFO
# RESEARCHRAG_DEBUG=false
